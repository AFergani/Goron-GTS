{
  "name": "goron-gts",
  "version": "1.0.69",
  "description": "Application de gestion des tableurs GTS",
  "main": "electron/main.js",
  "scripts": {
    "dev:ui": "vite",
    "dev:electron": "wait-on tcp:5173 && electron .",
    "dev": "concurrently -k \"npm:dev:ui\" \"npm:dev:electron\"",
    "dev:2:ui": "vite --port 5174",
    "dev:2:electron": "wait-on tcp:5174 && cross-env DEV_PORT=5174 electron .",
    "dev:2": "concurrently -k \"npm:dev:2:ui\" \"npm:dev:2:electron\"",
    "build:ui": "vite build",
    "build": "npm run build:ui",
    "dist:portable": "npm run build:ui && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win portable",
    "dist:installer": "npm run build:ui && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis",
    "dist:folder": "npm run build:ui && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win dir",
    "dist:win:all": "npm run build:ui && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win portable nsis dir",
    "release:portable": "node scripts/release-portable.js",
    "release:portable:minor": "node scripts/release-portable.js minor",
    "release:portable:major": "node scripts/release-portable.js major",
    "release:portable:nobump": "node scripts/release-portable.js --no-bump",
    "release:portable:fullclean": "node scripts/release-portable.js patch --reinstall-deps"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "docx": "^9.6.1",
    "docxtemplater": "^3.68.5",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.8.0",
    "pg": "^8.23.0",
    "pizzip": "^3.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.2/xlsx-0.20.2.tgz"
  },
  "devDependencies": {
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "rcedit": "^5.0.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "wait-on": "^9.0.5"
  },
  "overrides": {
    "axios": "^1.16.0"
  },
  "build": {
    "appId": "com.goron.gts",
    "productName": "Goron GTS",
    "afterPack": "scripts/embed-windows-icon.js",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release-build"
    },
    "win": {
      "icon": "electron/app-icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
