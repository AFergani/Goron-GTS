# Règles Cursor locales (optionnel par poste)
.cursor/
.cursorignore
.vscode/

# OS
.DS_Store
.Thumbs.db

# Dossier personnel — ne pas versionner
Z_Dossier_Perso/

# Releases packagées (ex. Release_Goron-GTS-1.0.63)
Release_Goron-GTS-*/

# Dépendances et builds
node_modules/
dist/
build/

# Vite
vite.config.js.timestamps-*
vite.config.ts.timestamps-*

# Environment variables
.env
.env.*
!.env.example
!.env.test

# Database files (dossier data à la racine du dépôt uniquement)
/data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.zip
*.sql
!electron/store/persistence/migrations/*.sql
!electron/store/domains/data/**/*.js

# Fichiers temporaires Office
~$*
